    "@types/react-dom": "^19.2.4",
    "@types/ungap__url-search-params": "^0.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "globals": "^17.10.0",
    "intl-messageformat": "10.7.16",
    "prettier": "^3.9.6",
