{
  "name": "assets-and-resources",
  "version": "0.10.100",
  "description": "Plugin to handle assets and resources directly within figma",
  "main": "code.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/ui/paraglide --strategy baseLocale --emit-ts-declarations",
    "pretsc": "pnpm paraglide:compile",
    "tsc": "tsc --noEmit",
    "pretest": "pnpm paraglide:compile",
    "test": "vitest run --config vitest.config.ts",
    "test:big-o": "vitest run --config vitest.config.ts src/performance/bigO.test.ts --reporter=verbose",
    "generate-strings": "node ./util/assets-and-resources.js;",
    "build": "vite build",
    "lint": "eslint .",
    "lintfix": "./node_modules/.bin/eslint . --fix ",
    "format": "prettier ./src --write"
  },
  "author": "Martin Lysk",
  "license": "",
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.133.0",
    "@inlang/paraglide-js": "^2.23.2",
    "@types/ejs": "^3.1.5",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ungap__url-search-params": "^0.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "globals": "^17.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-raw-plugin": "^1.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@inlang/plugin-android": "link:../inlang/packages/plugins/android",
    "@inlang/plugin-apple-strings": "link:../inlang/packages/plugins/apple-strings",
    "@inlang/plugin-i18next": "link:../inlang/packages/plugins/i18next",
    "@inlang/sdk": "link:../inlang/packages/sdk",
    "@ungap/url-search-params": "^0.2.2",
    "blakejs": "^1.2.1",
    "diff": "^9.0.0",
    "ejs": "^6.0.1",
    "javascript-time-ago": "^2.6.4",
    "lodash": "^4.18.1",
    "mixpanel-figma": "^2.0.4",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "parchment": "^3.0.0",
    "quill": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-select": "^5.10.2",
    "react-time-ago": "^7.4.4",
    "react-usestateref": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/runtime@<7.26.10": "7.29.7",
      "flatted@<3.4.4": "3.4.4",
      "picomatch@<2.3.2": "2.3.2",
      "yaml@>=1.0.0 <1.10.3": "1.10.3"
    }
  }
}
