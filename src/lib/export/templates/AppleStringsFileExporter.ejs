<%

/// BEGIN PREPARATION

// create data array
languageStrings = [];

// get only the data for the language we need
for (const [messageName, message] of Object.entries(input)) { // iterate over dictionary/object properties

	// we skip plurals
	if (message.plural) {
		console.log('Plurals are not yet supportet for export - ignoring Message '+ messageName +'')
		continue
	}

	// we skip gender - will be part of the apple dict file exporter
	if (message.gender) {
		console.log(' Gender are not yet supportet for export - ignoring Message '+ messageName +'')
		continue
	}

	// ==========================================
	// Singular String found (e.g. Language = de)
	// ==========================================

	let stringValue = message.variants[language]['n']['other'].text;
	// escape special characters
	stringValue = stringValue.replace(/"/g, '\\"'); // TODO #8 replace all placeholders

	// creates an item with only the essential data to be serialized/printed
	languageElement = {};
	languageElement.name = messageName;
	languageElement.value =  stringValue;
	// languageElement.comment = translations.comment;
	languageStrings.push(languageElement);

}

// sort it
languageStrings.sort((a, b) => a.name.localeCompare(b.name));

/// BEGIN TEMPLATE
-%>
/**
 * Apple Strings File
 * Language: <%-language%>
 */

 <%_ for (let i = 0; i < languageStrings.length; i++) { _%>
 "<%-languageStrings[i].name%>" = "<%-languageStrings[i].value%>";
 <%_ } _%>
