{
  "compilerOptions": {
    "sourceMap": true,
    "target": "es2022",
    "strict": true,
		// strict ES module
		"module": "es2020",
		// strict ES module
		"moduleResolution": "Bundler",
		"skipLibCheck": true,
		"types": ["@figma/plugin-typings", "node", "vite/client"],

    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noImplicitThis": false,
    "allowSyntheticDefaultImports": true,
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "manifest.figma.ts"],
  "exclude": ["snipets/**"]
}
