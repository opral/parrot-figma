<%

/// BEGIN PREPARATION

// create data array
languageStrings = [];

// get only the data for the language we need
for (const [keyName, key] of Object.entries(input)) { // iterate over dictionary/object properties

	// we skip plurals
	if (key.plural) {
		continue
	}
	// ==========================================
	// Singular String found (e.g. Language = de)
	// ==========================================

	let stringValue = key.translations[language]['other'].text;
	// escape special characters
	stringValue = stringValue.replace(/"/g, '\\"'); // TODO #8 replace all placeholders

	// creates an item with only the essential data to be serialized/printed
	languageElement = {};
	languageElement.key = keyName;
	languageElement.value =  stringValue;
	// languageElement.comment = translations.comment;
	languageStrings.push(languageElement);

}

// sort it
languageStrings.sort((a, b) => a.key.localeCompare(b.key));

/// BEGIN TEMPLATE
-%>
/**
 * Apple Strings File
 * Language: <%-language%>
 */

 <%_ for (let i = 0; i < languageStrings.length; i++) { _%>
 "<%-languageStrings[i].key%>" = "<%-languageStrings[i].value%>";
 <%_ } _%>
